# Rival frontend — PRODUCTION (used by `next build` / `next start`).
# Committed on purpose: no secrets here. NEXT_PUBLIC_* is exposed to the browser.
#
# Baked in at BUILD time, and it also drives the CSP `connect-src` / `img-src`
# in src/middleware.ts — so this must match your real API domain exactly, or the
# browser will block the app's own requests.
# On Vercel, a dashboard env var of the same name overrides this file.
NEXT_PUBLIC_API_URL=https://rival-io.onrender.com
