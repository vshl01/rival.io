# Base URL of the Rival API (no trailing slash).
# Used by the browser, so it must be reachable from the client.
#
# You normally do NOT need to set this: the per-environment defaults are
# committed in `.env.development` (http://localhost:4000) and `.env.production`
# (https://rival-io.onrender.com), and Next picks the right one automatically.
#
# Copy to `.env.local` only to override both for your own machine.
NEXT_PUBLIC_API_URL=http://localhost:4000
