# Test environment — used automatically when NODE_ENV=test (e.g. `npm test`).
# Points at a SEPARATE database so the test suite (which truncates tables
# between runs) never destroys your development/seed data.
# Safe to commit: contains only local, non-secret values.

NODE_ENV=test
PORT=4001

DATABASE_URL="postgresql://rival:rival@localhost:5432/rival_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret-test-access-secret-0001"
JWT_REFRESH_SECRET="test-refresh-secret-test-refresh-secret-0002"

CORS_ORIGINS="http://localhost:3000"
COOKIE_SECURE=false
