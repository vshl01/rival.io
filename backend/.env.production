# ─────────────────────────────────────────────────────────────
# Rival backend — PRODUCTION settings (NODE_ENV=production)
#
# Committed on purpose: non-secret, per-environment config only.
# NEVER put secrets here — set DATABASE_URL and the JWT_* secrets in the
# Render dashboard. Platform variables override this file.
# ─────────────────────────────────────────────────────────────

# Only the deployed frontend may call the API from a browser. Comma-separated
# if you add more (custom domain, preview URLs). No trailing slash.
# `*` is rejected at boot in production — see src/config/env.ts.
CORS_ORIGINS="https://rival-io.vercel.app"

# Served over HTTPS, and the frontend is on a different site than the API, so
# the refresh cookie needs SameSite=None; Secure.
COOKIE_SECURE=true
