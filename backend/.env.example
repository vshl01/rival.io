# ─────────────────────────────────────────────────────────────
# Rival backend — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# When using the provided docker-compose, this default works as-is.
DATABASE_URL="postgresql://rival:rival@localhost:5432/rival?schema=public"

# JWT secrets — generate with: openssl rand -base64 48
# MUST be long, random, and different from one another in production.
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-0123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-9876543210"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# NOTE: CORS_ORIGINS and COOKIE_SECURE are NOT set here. They are
# per-environment and live in the committed `.env.development` and
# `.env.production` files, which load before this one:
#   development -> CORS_ORIGINS="http://localhost:3000",     COOKIE_SECURE=false
#   production  -> CORS_ORIGINS="https://rival-io.vercel.app", COOKIE_SECURE=true
# "*" reflects any origin and is refused at boot when NODE_ENV=production.
# For a one-off local override, use `.env.development.local` (gitignored).

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
