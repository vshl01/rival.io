# ─────────────────────────────────────────────────────────────
# Rival backend — DEVELOPMENT settings (NODE_ENV=development)
#
# Committed on purpose: non-secret, per-environment config only.
# NEVER put secrets here — those belong in the gitignored `.env`.
# Loaded before `.env`, so these values win. See src/config/env.ts.
# ─────────────────────────────────────────────────────────────

# Only the local Next.js dev server may call the API from a browser.
CORS_ORIGINS="http://localhost:3000"

# No HTTPS locally, so the refresh cookie must not be Secure-only.
COOKIE_SECURE=false
